# Application
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=trefix_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Mailer
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=no-reply@example.com
MAIL_PASSWORD=replace-me
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME=Trefix
MAIL_SECURE=false
MAIL_ALLOW_FROM_OVERRIDE=false
MAIL_USE_QUEUE=false

# Security
JWT_SECRET=replace-me-with-a-random-string
JWT_EXPIRATION=1h
