# Application
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Public base URL of the web admin, used for invite activation links
WEB_APP_URL=http://localhost:3001

# Public base URL of this API, used to build absolute avatar links
API_BASE_URL=http://localhost:3000
THROTTLE_LIMIT=300
THROTTLE_TTL=60000

# Database
# When running inside Docker Compose, use `postgres` as DB_HOST.
DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=trefix_db
DB_DATABASE_TEST=trefix_test

# Redis
# When running inside Docker Compose, use `redis` as REDIS_HOST.
REDIS_HOST=localhost
REDIS_PORT=6379

# Mailer
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=no-reply@example.com
MAIL_PASSWORD=replace-me
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME=Trefix
MAIL_SECURE=false
MAIL_ALLOW_FROM_OVERRIDE=false
MAIL_USE_QUEUE=false

# Storage
S3_ENDPOINT=https://s3.example.com
S3_REGION=eu-central-1
S3_BUCKET=trefix-storage
S3_ACCESS_KEY=replace-me
S3_SECRET_KEY=replace-me
S3_FORCE_PATH_STYLE=true
STORAGE_MAX_FILE_SIZE=52428800

# Security
JWT_ACCESS_SECRET=replace-me-with-a-random-string
JWT_ACCESS_EXPIRATION=1h
AUTH_ACCESS_TOKEN_SECRET=replace-me-with-a-random-string
AUTH_ACCESS_TOKEN_EXPIRES_IN=15m
AUTH_REFRESH_TOKEN_SECRET=replace-me-with-a-different-random-string
AUTH_REFRESH_TOKEN_EXPIRES_IN=30d
AUTH_EMAIL_CODE_EXPIRES_IN=10m
AUTH_EMAIL_CODE_RESEND_COOLDOWN=60s
AUTH_PASSWORD_RESET_EXPIRES_IN=15m
AUTO_SEED_SYSTEM_DATA=true

# Social auth
GOOGLE_OAUTH_CLIENT_ID=678050162933-nuf4qfic96t8apc5qbf65udlp4n64582.apps.googleusercontent.com
APPLE_OAUTH_CLIENT_ID=Kanishchev.Trefix
APPLE_OAUTH_TEAM_ID=KT22FA2C2R
APPLE_OAUTH_KEY_ID=J38ZQ392XX
APPLE_OAUTH_PRIVATE_KEY_PATH=./keys/AuthKey_J38ZQ392XX.p8

# OpenAI
OPENAI_API_KEY=replace-me
OPENAI_MODEL=gpt-4o-mini

# System seeding
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-me-with-a-strong-password
