diff --git a/apple/Package.swift b/apple/Package.swift
index 77b0525..9065433 100644
--- a/apple/Package.swift
+++ b/apple/Package.swift
@@ -92,6 +92,23 @@ let package = Package(
         // https://github.com/swiftlang/swift-evolution/blob/main/proposals/0470-isolated-conformances.md
         .enableUpcomingFeature("InferIsolatedConformances"),
 
+        // Patched: Swift 5 mode + all Swift 6 upcoming features, so strict-concurrency
+        // diagnostics stay warnings on Xcode 26.2 (expo/expo#50067).
+        .enableUpcomingFeature("ConciseMagicFile"),
+        .enableUpcomingFeature("ForwardTrailingClosures"),
+        .enableUpcomingFeature("BareSlashRegexLiterals"),
+        .enableUpcomingFeature("DeprecateApplicationMain"),
+        .enableUpcomingFeature("ImportObjcForwardDeclarations"),
+        .enableUpcomingFeature("DisableOutwardActorInference"),
+        .enableUpcomingFeature("IsolatedDefaultValues"),
+        .enableUpcomingFeature("GlobalConcurrency"),
+        .enableUpcomingFeature("InferSendableFromCaptures"),
+        .enableUpcomingFeature("GlobalActorIsolatedTypesUsability"),
+        .enableUpcomingFeature("DynamicActorIsolation"),
+        .enableUpcomingFeature("NonfrozenEnumExhaustivity"),
+        .enableUpcomingFeature("RegionBasedIsolation"),
+        .enableUpcomingFeature("StrictConcurrency"),
+
         .unsafeFlags([
           "-enable-library-evolution",
           "-emit-module-interface",
@@ -150,7 +167,8 @@ let package = Package(
       path: "Benchmarks",
     ),
   ] + testFrameworks.binaryTargets,
-  swiftLanguageModes: [.v6],
+  // Patched: older Swift 6.2 (Xcode 26.2) rejects nonisolated(unsafe) captures as data races (expo/expo#50067).
+  swiftLanguageModes: [.v5],
   cxxLanguageStandard: .cxx20
 )
 
