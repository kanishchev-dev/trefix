# Скопируйте в .env.local и заполните.

# API бэкенда для серверной части Next (прокси /api/auth, /api/admin, middleware).
AUTH_BACKEND_URL=http://127.0.0.1:3000/v1

# Адрес бэкенда для WebSocket в браузере. Встраивается в бандл.
# Не задан — хост берётся из адреса страницы (работает и на localhost, и по сети).
# NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:3000/v1
