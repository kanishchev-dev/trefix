{
  "name": "workspace",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "pnpm --dir apps/web dev",
    "dev:mobile": "pnpm --dir apps/mobile dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "shadcn": "pnpm dlx shadcn@latest",
    "test": "turbo run test",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "turbo": "2.10.12",
    "typescript": "6.0.3"
  },
  "pnpm": {
    "patchedDependencies": {
      "expo-modules-jsi@57.1.0": "patches/expo-modules-jsi@57.1.0.patch"
    }
  }
}
