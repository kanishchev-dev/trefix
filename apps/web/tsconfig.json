{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": "../..",
    "ignoreDeprecations": "5.0",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "paths": {
      "@/*": ["./apps/web/src/*"],
      "@workspace/ui": ["./packages/ui/src/index.ts"],
      "@workspace/ui/*": ["./packages/ui/src/*"],
      "@workspace/api-client": ["./packages/api-client/src/index.ts"],
      "@workspace/api-client/*": ["./packages/api-client/src/*"],
      "@workspace/config": ["./packages/config/src/index.ts"],
      "@workspace/config/*": ["./packages/config/src/*"],
      "@workspace/tokens": ["./packages/tokens/src/index.ts"],
      "@workspace/tokens/*": ["./packages/tokens/src/*"],
      "@workspace/utils": ["./packages/utils/src/index.ts"],
      "@workspace/utils/*": ["./packages/utils/src/*"]
    }
  },
  "include": ["next-env.d.ts", "app/**/*", "src/**/*"],
  "exclude": ["node_modules"]
}
