			<array>
				<string>workspace-mobile</string>
				<string>Kanishchev.Trefix</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.678050162933-nuf4qfic96t8apc5qbf65udlp4n64582</string>
			</array>
