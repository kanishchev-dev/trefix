# Скопируйте в .env и заполните. Переменные EXPO_PUBLIC_* встраиваются в JS-бандл:
# только публичные значения, никаких секретов. После изменения — перезапуск Metro с -c.

# API бэкенда. В dev локальный адрес (127.0.0.1 / LAN) автоматически заменяется
# на хост Metro, так что телефон в той же сети достучится до бэкенда на Mac.
EXPO_PUBLIC_BACKEND_URL=http://127.0.0.1:3000/v1
# Устаревшее имя, читается, если EXPO_PUBLIC_BACKEND_URL не задан.
# EXPO_PUBLIC_AUTH_BACKEND_URL=http://127.0.0.1:3000/v1

# Google Sign-In: Web client ID из Google Cloud Console.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=

# Ссылки в экране входа, профиле и согласии на данные здоровья.
EXPO_PUBLIC_TERMS_URL=https://trefix.run/terms
EXPO_PUBLIC_PRIVACY_URL=https://trefix.run/privacy

# Карты трекера: публичный токен Mapbox (pk.…). Пусто — карты не показываются.
EXPO_PUBLIC_MAPBOX_TOKEN=

# Только для Android-сборки, если Gradle получает 401 от Mapbox:
# секретный токен (sk.…) со scope DOWNLOADS:READ. В бандл не попадает.
# RNMAPBOX_MAPS_DOWNLOAD_TOKEN=
