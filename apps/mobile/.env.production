# Release-сборки (Xcode Archive, gradlew assembleRelease/bundleRelease):
# Expo подхватывает этот файл при бандлинге с NODE_ENV=production и он
# перекрывает .env. Dev (Metro) его не читает. Только публичные значения.
# Внимание: .env.local приоритетнее этого файла — локальный адрес туда не класть.
EXPO_PUBLIC_BACKEND_URL=https://api.trefix.app/v1
