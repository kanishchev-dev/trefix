<html>
  <body>
    <h1>Activate your Trefix account</h1>
    <p>Hello {{firstName}} {{lastName}},</p>
    <p>
      An administrator has created an account for {{email}}. Use the activation
      code below to set your password and finish onboarding.
    </p>
    <p><strong>{{code}}</strong></p>
    <p>The code expires in {{expiresIn}} hours.</p>
    <p><a href="{{activationUrl}}">Activate your account</a></p>
  </body>
</html>