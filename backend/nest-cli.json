{
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "modules/mailer/templates/**/*",
        "outDir": "dist"
      },
      {
        "include": "i18n/**/*",
        "outDir": "dist"
      }
    ]
  }
}
